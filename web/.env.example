# Copy to `.env` and fill in from your Supabase project settings (API section).
#
# Leave BOTH unset to run on the in-memory mock backend — every screen works,
# seeded users answer your requests, and nothing leaves the browser. Set BOTH to
# point the same app at a real project.
#
# NOTE: anything prefixed VITE_ is embedded in the JavaScript bundle and is
# publicly readable. That is correct for the anon key, which is designed to be
# public — row-level security is what protects the data. Never put a service
# role key here.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
